<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Omslag hämtas via HTTPS från dmzarkivet.se (ADR 0015). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Permanenta nedladdningar (ADR 0013): på Android 14 och senare körs de som
        ett användarinitierat dataöverföringsjobb, som kräver en notis. Nätverkskravet
        i jobbet (wifi eller valfritt nät) kräver att appen får läsa nätverkets status.
    -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".DmzReaderApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DmzReader">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".offline.DownloadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".offline.DownloadCancelReceiver"
            android:exported="false" />
    </application>

</manifest>
