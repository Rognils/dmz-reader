<?xml version="1.0" encoding="utf-8"?>
<!--
  Androids egen backup är avstängd (ADR 0014). Ingenting följer med, varken
  till molnet eller vid överföring mellan enheter. Appens backupväg är den
  egna JSON-exporten (planens E11).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
